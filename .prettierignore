# Vite output. These are built by `make bundles` and committed so a clone
# runs with no Node step, and check-bundles.yaml rebuilds them and
# fails if what is committed differs. Reformatting them here would make that
# check fail on every run.
gallery/apps/*/vite/www/
examples/*/www/

# Built bundles, same reason.
pkg-js/dist/
pkg-js/dist-npm/
pkg-r/inst/lib/
pkg-py/src/bslibreact/www/

# Lockfiles and generated docs.
package-lock.json
pkg-js/docs/
