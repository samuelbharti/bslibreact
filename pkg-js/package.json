{
  "name": "bslib-react",
  "version": "0.1.0",
  "description": "bslib's layout, page shell, and output markup as React components for the shinyreact ui.tsx pattern",
  "license": "MIT",
  "author": "Samuel Bharti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelbharti/bslib-react.git",
    "directory": "pkg-js"
  },
  "homepage": "https://github.com/samuelbharti/bslib-react#readme",
  "bugs": {
    "url": "https://github.com/samuelbharti/bslib-react/issues"
  },
  "keywords": [
    "shiny",
    "shinyreact",
    "bslib",
    "react",
    "bootstrap",
    "r",
    "components"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist",
    "dist-npm",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist-npm/types/index.d.ts",
      "import": "./dist-npm/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:iife && npm run build:npm",
    "build:iife": "vite build",
    "build:npm": "vite build --config vite.config.npm.ts && tsc -p tsconfig.npm.json",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "test": "vitest run",
    "docs": "typedoc",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "peerDependencies": {
    "@posit-dev/shinyreact": "^0.1.1",
    "react": "19.x",
    "react-dom": "19.x"
  },
  "peerDependenciesMeta": {
    "@posit-dev/shinyreact": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@posit-dev/shinyreact": "^0.1.1",
    "@posit/shiny": "^1.11.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.1"
  }
}
