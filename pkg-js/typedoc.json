{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "./tsconfig.npm.json",
  "out": "docs",
  "name": "bslibreact (JavaScript)",
  "includeVersion": true,
  "hideGenerator": true,
  "treatWarningsAsErrors": true,
  "projectDocuments": ["guides/building-the-client.md"],
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "r",
    "python"
  ],
  "intentionallyNotExported": ["Props", "CardProps", "ModuleProps"],
  "navigationLinks": {
    "All docs": "https://www.samuelbharti.com/bslibreact/",
    "R docs": "https://www.samuelbharti.com/bslibreact/r/",
    "Python docs": "https://www.samuelbharti.com/bslibreact/py/",
    "GitHub": "https://github.com/samuelbharti/bslibreact"
  }
}
